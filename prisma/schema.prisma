generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MessageStatus {
  NEW
  READ
  IN_PROGRESS
  DONE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reservation {
  id        String            @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  type      String
  date      DateTime
  time      String
  message   String?           @db.Text
  status    ReservationStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, date])
}

model ContactMessage {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String        @db.Text
  source    String?
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  createdAt DateTime @default(now())
}

model Author {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  role      String?
  bio       String?   @db.Text
  avatarUrl String?
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id             String        @id @default(cuid())
  locale         String        @default("fr")
  title          String
  slug           String
  excerpt        String        @db.Text
  contentJson    Json
  contentHtml    String        @db.Text
  coverUrl       String?
  coverAlt       String?
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           Tag[]
  authorId       String?
  author         Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  readingMinutes Int           @default(5)
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  faq            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, publishedAt])
}

model Project {
  id             String        @id @default(cuid())
  locale         String        @default("fr")
  title          String
  slug           String
  client         String
  category       String
  excerpt        String        @db.Text
  description    String        @db.Text
  coverUrl       String?
  gallery        Json?
  technologies   Json
  objectives     Json
  results        Json?
  websiteUrl     String?
  testimonial    String?       @db.Text
  status         PublishStatus @default(DRAFT)
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
}

model Service {
  id             String        @id @default(cuid())
  locale         String        @default("fr")
  name           String
  slug           String
  summary        String        @db.Text
  description    String        @db.Text
  icon           String
  imageUrl       String?
  problem        String        @db.Text
  solution       String        @db.Text
  benefits       Json
  process        Json
  tools          Json
  faq            Json
  sortOrder      Int           @default(0)
  status         PublishStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String
  role      String?
  photoUrl  String?
  quote     String   @db.Text
  rating    Int?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  photoUrl    String?
  bio         String?  @db.Text
  linkedin    String?
  instagram   String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default("default")
  visits    Int      @default(0)
  data      Json?
  updatedAt DateTime @updatedAt
}
